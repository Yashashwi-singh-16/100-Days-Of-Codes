#include <stdio.h>

// Function declarations
void addNumbers();
void evenOdd();
void factorial();
void primeNumber();
void fibonacci();
void arrayOperations();

int main() {
    int choice;

    do {
        printf("\n====================================\n");
        printf("        C PROGRAMMING MENU\n");
        printf("====================================\n");
        printf("1. Add Two Numbers\n");
        printf("2. Check Even or Odd\n");
        printf("3. Find Factorial\n");
        printf("4. Check Prime Number\n");
        printf("5. Fibonacci Series\n");
        printf("6. Array Operations\n");
        printf("7. Exit\n");
        printf("====================================\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addNumbers();
                break;

            case 2:
                evenOdd();
                break;

            case 3:
                factorial();
                break;

            case 4:
                primeNumber();
                break;

            case 5:
                fibonacci();
                break;

            case 6:
                arrayOperations();
                break;

            case 7:
                printf("\nProgram ended. Thank you!\n");
                break;

            default:
                printf("\nInvalid choice! Please try again.\n");
        }

    } while (choice != 7);

    return 0;
}

// Function to add two numbers
void addNumbers() {
    int a, b, sum;

    printf("\nEnter first number: ");
    scanf("%d", &a);

    printf("Enter second number: ");
    scanf("%d", &b);

    sum = a + b;

    printf("Sum = %d\n", sum);
}

// Function to check even or odd
void evenOdd() {
    int n;

    printf("\nEnter a number: ");
    scanf("%d", &n);

    if (n % 2 == 0)
        printf("%d is Even.\n", n);
    else
        printf("%d is Odd.\n", n);
}

// Function to find factorial
void factorial() {
    int n, i;
    long long fact = 1;

    printf("\nEnter a number: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Factorial is not possible for negative numbers.\n");
        return;
    }

    for (i = 1; i <= n; i++) {
        fact = fact * i;
    }

    printf("Factorial of %d = %lld\n", n, fact);
}

// Function to check prime number
void primeNumber() {
    int n, i, flag = 0;

    printf("\nEnter a number: ");
    scanf("%d", &n);

    if (n <= 1) {
        printf("%d is not a prime number.\n", n);
        return;
    }

    for (i = 2; i <= n / 2; i++) {
        if (n % i == 0) {
            flag = 1;
            break;
        }
    }

    if (flag == 0)
        printf("%d is a Prime Number.\n", n);
    else
        printf("%d is not a Prime Number.\n", n);
}

// Function to print Fibonacci series
void fibonacci() {
    int n, i;
    int first = 0, second = 1, next;

    printf("\nEnter number of terms: ");
    scanf("%d", &n);

    printf("Fibonacci Series: ");

    for (i = 1; i <= n; i++) {
        printf("%d ", first);

        next = first + second;
        first = second;
        second = next;
    }

    printf("\n");
}

// Function for array operations
void arrayOperations() {
    int arr[100];
    int n, i;
    int sum = 0, largest, smallest;

    printf("\nEnter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    largest = arr[0];
    smallest = arr[0];

    for (i = 1; i < n; i++) {
        if (arr[i] > largest)
            largest = arr[i];

        if (arr[i] < smallest)
            smallest = arr[i];
    }

    printf("\nArray Elements: ");

    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    printf("\nSum = %d", sum);
    printf("\nLargest = %d", largest);
    printf("\nSmallest = %d", smallest);
    printf("\nAverage = %.2f\n", (float)sum / n);
}
